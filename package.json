{
  "name": "cordclean",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "CordClean - 基于 Cordis 插件框架的模块化电脑清理工具",
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@12.14.0",
  "scripts": {
    "dev:web": "tsx apps/web/src/main.ts",
    "dev:desktop": "node scripts/build-desktop.mjs && electron apps/desktop/dist/main.mjs",
    "build:ui": "pnpm --filter @cordclean/ui build",
    "build:desktop": "node scripts/build-desktop.mjs",
    "build": "pnpm build:ui && pnpm build:desktop",
    "start:web": "pnpm build:ui && tsx apps/web/src/main.ts",
    "start:desktop": "pnpm build:ui && node scripts/build-desktop.mjs && electron apps/desktop/dist/main.mjs",
    "pretest": "pnpm build:ui",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "bench": "tsx bench/scan.bench.ts",
    "smoke": "tsx scripts/smoke.ts",
    "mock:llm": "node scripts/mock-llm.mjs"
  },
  "devDependencies": {
    "@cordclean/core": "workspace:*",
    "@cordclean/host": "workspace:*",
    "@cordclean/shared": "workspace:*",
    "@cordclean/utils": "workspace:*",
    "@types/node": "^24.0.0",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-vue": "^6.0.1",
    "electron": "^38.0.0",
    "esbuild": "^0.25.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vite": "^7.1.0",
    "vitest": "^3.2.0",
    "vue-tsc": "^3.0.0"
  },
  "dependencies": {
    "cordis": "4.0.0-rc.11",
    "schemastery": "^3.18.0",
    "ws": "^8.22.0"
  }
}
